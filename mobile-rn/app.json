{
  "expo": {
    "name": "openGym RN",
    "slug": "opengym-rn",
    "scheme": "opengym",
    "version": "0.1.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "android": {
      "package": "dev.opengym.rn",
      "versionCode": 6,
      "allowBackup": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-sharing",
      "expo-notifications",
      "expo-image",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "允许 openGym 使用相机扫描配对二维码。",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 openGym 读取你选择的进度照片。"
        }
      ]
    ]
  }
}
