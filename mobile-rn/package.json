{
  "name": "opengym-rn",
  "version": "0.1.6",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "eslint App.tsx index.ts src",
    "lint:rules": "node --test --test-reporter=dot scripts/eslint-rules.test.cjs",
    "catalogue:generate": "node scripts/generate-catalogue-content.mjs",
    "catalogue:stage": "node scripts/stage-catalogue-media.mjs",
    "check": "npm run lint && npm run lint:rules && npm run typecheck && npm run design:check",
    "typecheck": "tsc --noEmit",
    "design:check": "node scripts/check-design-system.mjs"
  },
  "dependencies": {
    "expo": "~55.0.32",
    "expo-build-properties": "~55.0.18",
    "expo-camera": "~55.0.23",
    "expo-crypto": "~55.0.19",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-image": "~55.0.11",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-notifications": "~55.0.27",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-video": "~55.0.21",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3"
  },
  "devDependencies": {
    "@eslint-community/eslint-utils": "^4.10.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~55.0.25",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.1",
    "typescript": "~5.9.2"
  },
  "license": "AGPL-3.0-or-later",
  "private": true
}
